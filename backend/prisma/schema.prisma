// The datasource URL lives in prisma.config.ts (Prisma 7 moved it out of the schema).
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

/// What a Viewer may do with Questions. Administrator is deliberately absent: it is an
/// authority held beside one of these rather than a fourth value replacing one
/// (ADR-0015).
enum ViewerRole {
  reader
  author
  reviewer
}

/// The authenticated person a request acts as. No Viewer is ever deleted (ADR-0017),
/// so nothing here cascades.
model Viewer {
  id           String     @id @default(uuid()) @db.Uuid
  /// Lower-cased on the way in, so an address matches however it was typed.
  email        String     @unique
  /// The output of the password hasher, algorithm and parameters included. Never leaves
  /// the database: no response, no log line. Null for a Viewer an Administrator created
  /// who has not set a password yet, and nobody can log in as them until they do.
  passwordHash String?
  role         ViewerRole
  /// The Administrator authority, held beside `role` rather than as a fourth value of it
  /// (ADR-0015). Confers no access to Questions.
  isAdministrator Boolean @default(false)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  refreshTokens    RefreshToken[]
  permissionGrants PermissionGrant[]
  questions        Question[]
  changeEvents     ChangeEvent[]

  @@map("viewers")
}

/// A refresh token, held in PostgreSQL rather than a cache because revocation and
/// reuse detection are relational and have to survive a restart (ADR-0008).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  /// Shared by every token rotated out of one login, so a detected reuse can revoke
  /// each session descended from the token that leaked.
  familyId  String    @db.Uuid
  viewerId  String    @db.Uuid
  viewer    Viewer    @relation(fields: [viewerId], references: [id])
  /// The SHA-256 of the token. The token itself exists only in the caller's cookie, so
  /// a copy of this table is not a set of usable credentials.
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  /// When this token was rotated away; presenting it after this is the reuse.
  spentAt   DateTime? @db.Timestamptz(3)
  /// Set on every member of a family at once, by a logout or by a detected reuse.
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  // Revocation reads a whole family at a time; the viewer index is what lets
  // Deactivating a Viewer revoke their families immediately (ADR-0017).
  @@index([familyId])
  @@index([viewerId])
  @@map("refresh_tokens")
}

/// Whether a Question is awaiting a Reviewer, in the bank, or refused. A column and not
/// a second table (ADR-0013).
enum PublicationState {
  pending
  published
  rejected
}

/// Where a Question came from. A column and not a Category, because a Tag can express
/// neither "required" nor "exactly one".
enum Provenance {
  original
  adapted
  inherited
}

/// A named axis along which Questions are classified. These rows carry the ids Tags hang
/// from; the names themselves are closed in `@iqb/shared` (ADR-0024).
model Category {
  id          String   @id @default(uuid()) @db.Uuid
  /// The spelling a request writes, and the one `categoryNames` holds.
  name        String   @unique
  /// What a person reads, so the wire spelling never has to be shown to anyone.
  displayName String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  tags Tag[]

  @@map("categories")
}

/// A single value belonging to exactly one Category, which the required `categoryId` and
/// the unique pair are what make true rather than conventional.
model Tag {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])
  value      String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  questions QuestionTag[]

  @@unique([categoryId, value])
  @@map("tags")
}

/// An organisation a Question may be restricted to. Never deleted (ADR-0017).
model Client {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  permissionGrants PermissionGrant[]
  questions        Question[]

  @@map("clients")
}

/// The authority for one Viewer to see one Client's Questions.
model PermissionGrant {
  id        String   @id @default(uuid()) @db.Uuid
  viewerId  String   @db.Uuid
  viewer    Viewer   @relation(fields: [viewerId], references: [id])
  clientId  String   @db.Uuid
  client    Client   @relation(fields: [clientId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([viewerId, clientId])
  @@index([clientId])
  @@map("permission_grants")
}

/// A single interview or screening question, with its Answer Notes, Tags and Provenance.
/// Every read of this table goes through one scoped query builder, and the guarantee is
/// structural: a second path to this table removes it (ADR-0003).
model Question {
  id               String           @id @default(uuid()) @db.Uuid
  text             String
  answerNotes      String
  authorId         String           @db.Uuid
  author           Viewer           @relation(fields: [authorId], references: [id])
  /// At most one Client, and optional: unrestricted is the absence of a restriction
  /// rather than a value meaning "everyone".
  clientId         String?          @db.Uuid
  // Restrict, against Prisma's SET NULL default: a deleted Client would otherwise
  // silently declassify every Question restricted to it (ADR-0017).
  client           Client?          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  publicationState PublicationState @default(pending)
  provenance       Provenance
  /// Named in the Author's own words, so free text rather than a link or a Tag.
  source           String?
  /// The lexemes of text and Answer Notes, kept up to date by PostgreSQL itself. Optional,
  /// and the expression is repeated here, or `migrate dev` drops what the migration made
  /// and the client loses create, update and upsert (ADR-0004).
  searchVector     Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, ((COALESCE(text, ''::text) || ' '::text) || COALESCE(\"answerNotes\", ''::text)))"))
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  tags         QuestionTag[]
  changeEvents ChangeEvent[]

  // What makes the keyword search an index lookup rather than a scan (ADR-0004).
  @@index([searchVector], type: Gin)
  // Near-duplicate detection orders by how close a submission is to each Question, and
  // GiST is the only index type that can answer that ordering (ADR-0004). Declared here
  // as well as in the migration, or the next `migrate dev` drops it.
  @@index([text(ops: raw("gist_trgm_ops"))], type: Gist)
  // Load-bearing: the ordering index the combined filter's early-stop strategy walks,
  // and what makes pagination stable. Dropping it removes a plan (ADR-0011).
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([clientId])
  @@index([authorId])
  @@map("questions")
}

/// A Question carrying a Tag; several within one Category and across several are alike.
model QuestionTag {
  questionId String   @db.Uuid
  question   Question @relation(fields: [questionId], references: [id])
  tagId      String   @db.Uuid
  tag        Tag      @relation(fields: [tagId], references: [id])

  @@id([questionId, tagId])
  // The other direction of the primary key, which is the index the planner drives from
  // on a selective filter (ADR-0011).
  @@index([tagId, questionId])
  @@map("question_tags")
}

/// What happened to the bank. The tickets that Publish and Reject add their own
/// (ADR-0006).
enum ChangeEventType {
  question_added
  question_edited
  near_duplicate_refused
  near_duplicate_overridden
  administrator_appointed
  administrator_withdrawn
  role_changed
  client_created
  permission_grant_issued
  permission_grant_revoked
}

/// An append-only record of something that happened to the bank, naming who did it and
/// when. Nothing here is ever updated or deleted, and a trigger in the migration is what
/// holds to that rather than everyone remembering to (ADR-0027).
model ChangeEvent {
  id         String          @id @default(uuid()) @db.Uuid
  /// Null for an event about a submission that stored no Question, which is the whole
  /// reason this is a log and not a version of the questions table (ADR-0006).
  questionId String?         @db.Uuid
  // Restrict, against Prisma's SET NULL default for an optional relation: a deleted
  // Question would otherwise quietly cut its own history loose (ADR-0017).
  question   Question?       @relation(fields: [questionId], references: [id], onDelete: Restrict)
  /// The Viewer who did it. They keep their name here after they are Deactivated
  /// (ADR-0017), which is why nothing about this row cascades.
  viewerId   String          @db.Uuid
  viewer     Viewer          @relation(fields: [viewerId], references: [id])
  type       ChangeEventType
  /// What happened, in the shape the type names: the whole content of an addition, or
  /// before and after for each field an edit changed.
  payload    Json
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  // The history of one Question in order, which is the only way this table is read.
  @@index([questionId, createdAt])
  @@map("change_events")
}
