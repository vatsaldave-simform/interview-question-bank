// The datasource URL lives in prisma.config.ts (Prisma 7 moved it out of the schema).
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

