{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    // Node loads the file an import names, so imports end in `.ts` (ADR-0032).
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    // Node only removes types, so reject code that needs more than that (ADR-0032).
    "erasableSyntaxOnly": true
  },
  "include": ["src"]
}
