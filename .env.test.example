# Copy to .env.test for `pnpm test`.
#
# This is the test database service from docker compose, not the development one. The
# suite truncates whatever it connects to and refuses to start unless the database name
# contains "test".
DATABASE_URL=postgresql://iqb:iqb@localhost:5433/iqb_test
LOG_LEVEL=silent

# For commands run by hand against the test database — `pnpm db:seed`, and anything else
# that validates the whole environment on its way in. The suite builds the application
# itself and passes its own token settings, so no test reads this value.
ACCESS_TOKEN_SECRET=not-read-by-the-suite-only-by-commands
MAIL_URL=smtp://localhost:1025
MAIL_FROM=bank@iqb.test
MAIL_REQUIRE_TLS=false
