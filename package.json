{
  "name": "interview-question-bank",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @iqb/shared build && pnpm --parallel --filter @iqb/backend --filter @iqb/frontend dev",
    "typecheck": "pnpm --filter @iqb/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @iqb/shared build && pnpm --filter @iqb/backend test",
    "db:migrate": "pnpm --filter @iqb/backend db:migrate",
    "db:generate": "pnpm --filter @iqb/backend db:generate"
  },
  "packageManager": "pnpm@9.15.9"
}
