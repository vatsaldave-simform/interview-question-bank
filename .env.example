# Copy to .env for `docker compose up`. Real environment variables win over anything
# set here. The suite reads .env.test instead; copy that one from .env.test.example.

# --- Postgres (read by the db and db-test services) ---
POSTGRES_USER=iqb
POSTGRES_PASSWORD=iqb
POSTGRES_DB=iqb

# The port the development database is published on. The test database is published
# on DB_TEST_PORT and is a separate service with its own storage, so running the suite
# never touches development data.
DB_PORT=5432
DB_TEST_PORT=5433

# --- API ---
PORT=3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# Connections this process may hold. Bounded deliberately; ADR-0012 has the reasoning.
DATABASE_POOL_MAX=10

# Where the built client lives, for the deployed image where one Express service serves
# both it and the API. Leave it unset here: in development Vite serves the client on
# FRONTEND_PORT and proxies the API's paths through, and the suite runs the API alone.
# FRONTEND_DIR=

# Inside docker compose the API reaches the database as the host `db`. Running the API
# on the host instead, use localhost:${DB_PORT}.
DATABASE_URL=postgresql://iqb:iqb@localhost:5432/iqb

# --- Client ---
FRONTEND_PORT=5173
API_ORIGIN=http://localhost:3000
