# Copy to .env for `docker compose up`. Real environment variables win over anything
# set here. The suite reads .env.test instead; copy that one from .env.test.example.

# --- Postgres (read by the db and db-test services) ---
POSTGRES_USER=iqb
POSTGRES_PASSWORD=iqb
POSTGRES_DB=iqb

# The port the development database is published on. The test database is published
# on DB_TEST_PORT and is a separate service with its own storage, so running the suite
# never touches development data.
DB_PORT=5432
DB_TEST_PORT=5433

# --- API ---
PORT=3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# Connections this process may hold. Bounded deliberately; ADR-0012 has the reasoning.
DATABASE_POOL_MAX=10

# Signs access tokens, so anything holding it can mint one for any Viewer. At least 32
# characters, and a real random value anywhere that is not a laptop:
#   openssl rand -base64 48
ACCESS_TOKEN_SECRET=local-development-access-token-secret

# How long an access token lasts, in seconds. Short on purpose (ADR-0008); the client
# refreshes rather than holding a long-lived one.
ACCESS_TOKEN_LIFETIME_SECONDS=900

# How long a refresh token lasts, in seconds, and so how long a session survives being
# away from it. Thirty days here; rotation on every use is what limits a stolen one
# (ADR-0008).
REFRESH_TOKEN_LIFETIME_SECONDS=2592000

# Whether the refresh cookie is marked Secure. False here alone, because a Secure cookie
# is not sent over http and local development is not served over https.
REFRESH_COOKIE_SECURE=false

# Failed attempts on the authentication endpoints one caller address may make within the
# window before being refused with a 429. Successful ones do not count, and each of
# login, refresh and logout carries its own allowance; the names keep the LOGIN_ prefix
# from when login was the only one (ADR-0021).
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Proxies in front of the API. Zero here, where requests arrive directly; behind one it
# must match the real depth or the rate limit keys on the proxy rather than the caller,
# and trusting more hops than there are lets a caller spoof the address (ADR-0021).
TRUST_PROXY_HOPS=0

# Where the built client lives, for the deployed image where one Express service serves
# both it and the API. Leave it unset here: in development Vite serves the client on
# FRONTEND_PORT and proxies the API's paths through, and the suite runs the API alone.
# FRONTEND_DIR=

# Where outbound mail goes. Here it is Mailpit, the `mail` compose service, which keeps
# every message and shows them at http://localhost:8025 instead of delivering them.
# Inside docker compose the API reaches it as the host `mail`, and compose sets that
# itself. Deployed, it is Brevo on port 2525 (README, ADR-0037).
MAIL_URL=smtp://localhost:1025
MAIL_FROM=Interview Question Bank <bank@iqb.test>
# Mailpit offers no TLS. Leave this unset anywhere else, so it defaults to true and the
# SMTP password is never sent over a connection that was not encrypted.
MAIL_REQUIRE_TLS=false
# The host ports Mailpit is published on.
MAIL_SMTP_PORT=1025
MAIL_WEB_PORT=8025

# The address people open the bank at, which mailed links point to. Vite's, because under
# `pnpm dev` it serves the client; `docker compose up` sets its own.
APP_URL=http://localhost:5173

# How long a new Viewer's set-password link works, in seconds. Three days.
SET_PASSWORD_LINK_LIFETIME_SECONDS=259200

# Inside docker compose the API reaches the database as the host `db`. Running the API
# on the host instead, use localhost:${DB_PORT}.
DATABASE_URL=postgresql://iqb:iqb@localhost:5432/iqb

# Optional. `prisma migrate dev` replays the migration history into a scratch database to
# work out what changed. Left unset, it makes and drops one of its own, which needs a
# database user allowed to create databases.
# SHADOW_DATABASE_URL=postgresql://iqb:iqb@localhost:5432/iqb_shadow

# --- Client ---
FRONTEND_PORT=5173
API_ORIGIN=http://localhost:3000
